{
  "name": "grapity-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#12121a",
    "editor.foreground": "#e4e4ed"
  },
  "tokenColors": [
    {
      "scope": ["keyword", "storage.type", "keyword.control"],
      "settings": { "foreground": "#6366f1" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "string.interpolated"],
      "settings": { "foreground": "#e4e4ed" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#e4e4ed" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8888a0" }
    },
    {
      "scope": ["variable", "identifier", "entity.name.type"],
      "settings": { "foreground": "#e4e4ed" }
    },
    {
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": { "foreground": "#e4e4ed" }
    },
    {
      "scope": ["punctuation", "operator", "keyword.operator"],
      "settings": { "foreground": "#8888a0" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#6366f1" }
    },
    {
      "scope": ["attribute.name"],
      "settings": { "foreground": "#a5f3c4" }
    },
    {
      "scope": ["attribute.value"],
      "settings": { "foreground": "#06b6d4" }
    }
  ]
}
